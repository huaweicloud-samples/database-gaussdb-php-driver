  "type": "library",
  "license": "Apache-2.0",
  "homepage": "https://github.com/huaweicloud-samples/database-gaussdb-php-driver",
  "support": {
    "issues": "https://github.com/huaweicloud-samples/database-gaussdb-php-driver/issues",
    "source": "https://github.com/huaweicloud-samples/database-gaussdb-php-driver"
  },
  "require": {
    "php": ">=7.2.34",
    "ext-pdo": "*",
    "ext-pdo_odbc": "*",
